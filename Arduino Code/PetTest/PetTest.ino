void setup(void)
{
#ifdef DEV_DEVICE_INIT
  DEV_DEVICE_INIT();
#endif

  Serial.begin(115200);
  // Serial.setDebugOutput(true);
  // while(!Serial);
  Serial.println("Arduino_GFX Set Text Bound example");

  // Init Display
  if (!gfx->begin())
  {
    Serial.println("gfx->begin() failed!");
  }
  gfx->fillScreen(RGB565_PURPLE);

#ifdef GFX_BL
  pinMode(GFX_BL, OUTPUT);
  digitalWrite(GFX_BL, HIGH);
#endif

  //gfx->setTextSize(3, 3, 1);
  //gfx->setCursor(80, 150);
  //gfx->setFont(u8g2_font_unifont_t_animals);
  //gfx->setTextColor(RGB565_PINK);
  //gfx->setTextSize(10);
  //gfx->println(pet);

	display_pet(90, 20);

  Set_Color(0, 140, 225); // GRB for some reason, sets the outside RGB lights using a premade .h and .cpp file

  delay(1000);
}

void loop()
{
	refresh_pet((location+2.5)*20, 20);

  if (direction) {
    location += 1;
  } else {
    location -= 1;
  }

  if (location == 0 || location == 4) {
    direction = !direction;
    Serial.println("bounce");
    gfx->setTextSize(10);
  }
  else if (location == 1 || location == 3) {
    gfx->setTextSize(10, 8);
  }
  else if (location == 2) {
    gfx->setTextSize(10);
  }

  //gfx->setCursor((location+1.5)*20, 150);
  //gfx->setTextColor(RGB565_PINK);
  //gfx->println(pet);
	display_pet((location+2.5)*20, 20);

  Serial.println(location);

  delay(1000);
}
